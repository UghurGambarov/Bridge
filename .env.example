# Copy to .env and fill in. .env is git-ignored. Secrets come only from environment variables.

# LLM provider: mock | openai_compatible | anthropic
#   mock is deterministic and used by tests and CI (no key needed).
LLM_PROVIDER=mock

# openai_compatible covers OpenAI, DeepSeek, Qwen (DashScope compatible mode), Ollama, OpenRouter...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# anthropic (optional; needs `pip install anthropic`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Storage (defaults shown)
# DATABASE_URL=sqlite:///data/bridge.db
# DATA_DIR=data
