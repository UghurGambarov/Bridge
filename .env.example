# Copy to .env and fill in. .env is git-ignored. Secrets come only from environment variables.

# LLM provider: mock | openai_compatible | anthropic
#   mock is deterministic and used by tests and CI (no key needed).
LLM_PROVIDER=mock

# openai_compatible covers Google Gemini API, OpenAI, DeepSeek, Qwen (DashScope compatible mode), Ollama, OpenRouter...
#   Gemini (key from Google AI Studio):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                                        LLM_MODEL=gemini-3.5-flash
#   DeepSeek:                            LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Optional sampling temperature; leave empty for the provider default (recommended for Gemini 3 models).
LLM_TEMPERATURE=

# anthropic (optional; needs `pip install anthropic`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Storage (defaults shown)
# DATABASE_URL=sqlite:///data/bridge.db
# DATA_DIR=data
